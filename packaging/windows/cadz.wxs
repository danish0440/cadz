<?xml version="1.0" encoding="utf-8"?>
<!--
  CadZ MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus the WixUI extension:
  `wix extension add -g WixToolset.UI.wixext/5.0.2`). Built by package.ps1:

    wix build cadz.wxs -arch x64 -ext WixToolset.UI.wixext -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files, a Start Menu shortcut, an optional desktop shortcut, and
  CadZ offered under "Open with" for .dxf and .dwg drawings (without taking over the user's
  default app).

  Desktop shortcut: the setup wizard asks (unchecked by default). Silent installs leave it out
  unless asked: `msiexec /i cadz.msi /qn DESKTOPSHORTCUT=1`. Upgrades keep the previous choice
  unless DESKTOPSHORTCUT=1 or DESKTOPSHORTCUT=0 is given.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?ifndef HasCraftFontLicences ?>
  <?define HasCraftFontLicences=0 ?>
  <?endif ?>
  <Package
      Name="CadZ"
      Manufacturer="Learning Machines LLC"
      Version="$(var.Version)"
      UpgradeCode="819D32EF-0995-5B58-8836-D986ACC1915F"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="CadZ computer-aided design" Manufacturer="Learning Machines LLC" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of CadZ is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="CadzIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="CadzIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/danish0440/cadz" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/danish0440/cadz" />
    <Property Id="ARPHELPLINK" Value="https://github.com/danish0440/cadz/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="CadZ" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <!-- Per-machine (ALLUSERS=1), so this is the all-users (Public) desktop, like the Start Menu above. -->
    <StandardDirectory Id="DesktopFolder" />

    <!-- "Create a desktop shortcut": the wizard's checkbox sets it to 1 (cleared = unset), and
         silent installs pass DESKTOPSHORTCUT=1. Secure, so the elevated install sees the UI choice. -->
    <Property Id="DESKTOPSHORTCUT" Secure="yes" />
    <!-- The previous install's choice (the shortcut component's HKCU key path, so the installing
         user's), so upgrades keep the desktop shortcut without asking again. -->
    <Property Id="PREVIOUSDESKTOPSHORTCUT">
      <RegistrySearch Id="PreviousDesktopShortcut" Root="HKCU" Key="Software\Learning Machines LLC\CadZ"
          Name="DesktopShortcut" Type="raw" />
    </Property>
    <!-- Only when DESKTOPSHORTCUT wasn't given; "first" runs it once (in the UI sequence when there
         is one), so unticking the box isn't undone by the execute sequence. -->
    <SetProperty Id="DESKTOPSHORTCUT" Value="1" After="AppSearch" Sequence="first"
        Condition="NOT DESKTOPSHORTCUT AND PREVIOUSDESKTOPSHORTCUT = &quot;1&quot;" />

    <UIRef Id="CadzUI" />

    <Feature Id="Main" Title="CadZ" Level="1">
      <?if $(var.HasCraftFontLicences) = 1 ?>
      <ComponentGroupRef Id="CraftFontLicences" />
      <?endif ?>
      <ComponentGroupRef Id="CadzFiles" />
    </Feature>
  </Package>

  <Fragment>
    <?if $(var.HasCraftFontLicences) = 1 ?>
    <ComponentGroup Id="CraftFontLicences" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <?endif ?>
    <ComponentGroup Id="CadzFiles" Directory="INSTALLFOLDER">
      <Component Id="CadzApp" Guid="28E3E11B-B739-5275-979A-1DF166BC4A44">
        <File Id="CadzExe" Source="$(var.BinDir)\cadz.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="CadZ"
              Description="CadZ computer-aided design" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="CadzIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\cadz.exe" Value="[#CadzExe]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\cadz.exe\shell\open\command" Value="&quot;[#CadzExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.dxf\OpenWithProgids" Name="CadZ.Drawing" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.dwg\OpenWithProgids" Name="CadZ.Drawing" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\CadZ.Drawing\shell\open\command" Value="&quot;[#CadzExe]&quot; &quot;%1&quot;" Type="string" />
      </Component>

      <Component Id="CadzCli">
        <File Id="CadzCliExe" Source="$(var.BinDir)\cadz-cli.exe" KeyPath="yes" />
      </Component>

      <!-- Optional desktop shortcut, removed on uninstall. A non-advertised shortcut needs a registry
           key path, and one in a profile folder (DesktopFolder, even though ALLUSERS=1 makes it the
           Public desktop) must be under HKCU (ICE38, ICE43, ICE57). -->
      <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="5B279FB5-3B6D-5BD2-AD74-60202FDE8466"
          Condition="DESKTOPSHORTCUT = &quot;1&quot;">
        <Shortcut Id="DesktopShortcut" Name="CadZ" Description="CadZ computer-aided design"
            Target="[INSTALLFOLDER]cadz.exe" WorkingDirectory="INSTALLFOLDER" Icon="CadzIcon.ico" IconIndex="0" />
        <RegistryValue Root="HKCU" Key="Software\Learning Machines LLC\CadZ" Name="DesktopShortcut"
            Value="1" Type="string" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!--
    Setup wizard: WixUI_InstallDir's flow (WiX v5, ext/UI/wixlib/WixUI_InstallDir.wxs) without the
    licence and folder pages, plus a Shortcuts page:
      install:     Welcome > Shortcuts > Ready to install > Progress > Finish
      maintenance: Maintenance welcome > Repair/Remove > Ready > Progress > Finish
  -->
  <Fragment>
    <UI Id="CadzUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="DiskCostDlg" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <Dialog Id="ShortcutsDlg" Width="370" Height="270" Title="!(loc.InstallDirDlg_Title)">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>

        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes"
            Text="Choose where to start [ProductName] from." />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes"
            Text="{\WixUI_Font_Title}Shortcuts" />
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <Control Id="StartMenuText" Type="Text" X="20" Y="60" Width="330" Height="15" NoPrefix="yes"
            Text="[ProductName] will be added to the Start menu." />
        <Control Id="DesktopShortcutCheckBox" Type="CheckBox" X="20" Y="85" Width="330" Height="17"
            Property="DESKTOPSHORTCUT" CheckBoxValue="1" Text="Create a &amp;desktop shortcut" />
      </Dialog>

      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="ShortcutsDlg" Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="Installed AND PATCH" />

      <Publish Dialog="ShortcutsDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" />
      <Publish Dialog="ShortcutsDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" />

      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ShortcutsDlg" Order="1" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed AND NOT PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="Installed AND PATCH" />

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />

      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />

      <!-- No "Change" in Apps & features: there is a single feature. -->
      <Property Id="ARPNOMODIFY" Value="1" />
    </UI>

    <UIRef Id="WixUI_Common" />
  </Fragment>
</Wix>
